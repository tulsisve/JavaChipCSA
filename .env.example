# ============================================================================
# JavaChip — environment variables
# Copy this file to .env.local for local development. Every value below is
# a placeholder; see README.md for how to obtain real ones.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key. Server-only. NEVER prefix with NEXT_PUBLIC_, never send
# to the browser. Used only by the Stripe webhook handler and admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ------------------------------------------------------------------
# Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Product catalog → JavaChip Pro → each Price's ID.
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# --- App -----------------------------------------------------------------
# Used to build absolute redirect/callback URLs (Stripe Checkout success
# URL, Supabase email-confirmation redirect, etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Java code execution (optional) ------------------------------------
# JavaChip never compiles or runs untrusted Java inside this app server.
# When unset, the FRQ/syntax editors fall back to simulated test-case
# checking (structural + string-based). Point this at a sandboxed judge
# service (isolated container, strict CPU/memory/time limits, no network)
# to enable real compilation and execution. See lib/code-execution/README.md.
JAVA_EXECUTION_SERVICE_URL=
JAVA_EXECUTION_SERVICE_API_KEY=
